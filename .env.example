# Server
NODE_ENV=development
PORT=5000

# MySQL (Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CyberVault
DB_USER=root
DB_PASSWORD=<your_mysql_password>
DB_NAME_TEST=bank_test

# JWT
JWT_SECRET=<min 64 char random string>
JWT_REFRESH_SECRET=<min 64 char random string>
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-GCM)
ENCRYPTION_KEY=<64 hex chars = 32 bytes>

# CORS
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-domain>.vercel.app

# Logging
LOG_LEVEL=info

# Email (future — log-only for now)
CONTACT_EMAIL=mbadwy480@gmail.com
