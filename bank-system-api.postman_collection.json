                },
                {
                  "key": "minAmount",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "maxAmount",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Get any user's transaction history. Admin and employee only.\n\n**Error codes:**\n- `403 FORBIDDEN` — regular user calling this"
          },
          "response": []
        }
      ]
    },
