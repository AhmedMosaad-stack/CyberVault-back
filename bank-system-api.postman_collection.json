                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (default: 10, max: 100)"
                },
                {
                  "key": "name",
                  "value": "",
                  "description": "Filter by name (partial match)",
                  "disabled": true
                },
                {
